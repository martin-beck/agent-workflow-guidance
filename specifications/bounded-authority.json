  "formalization": {"method": "state-machine", "model_ref": "specifications/bounded-authority.json", "checker": "tools/check_spec.py", "command": ["python", "tools/check_spec.py", "specifications/bounded-authority.json"], "scope": "offline authority and audit lifecycle", "expected_result": "invariants-hold", "timeout_seconds": 60, "model": {"states": ["packet", "scoped", "approved", "rejected", "expired", "audited"], "initial": "packet", "transitions": [{"from": "packet", "to": "scoped"}, {"from": "scoped", "to": "approved"}, {"from": "scoped", "to": "rejected"}, {"from": "scoped", "to": "expired"}, {"from": "approved", "to": "audited"}, {"from": "rejected", "to": "audited"}, {"from": "expired", "to": "audited"}], "forbidden_transitions": [{"from": "packet", "to": "approved"}, {"from": "rejected", "to": "approved"}, {"from": "expired", "to": "approved"}]}}
