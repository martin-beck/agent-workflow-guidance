  "acceptance_predicates": ["Uncertainty and dependent-task changes can create packets", "A synthetic high-impact action pauses", "No runtime adapter is claimed by this design check", "Resume requires a matching oracle decision"],
  "formalization": {"method": "state-machine", "model_ref": "specifications/openhands-decision-gates.json", "checker": "tools/check_spec.py", "command": ["python", "tools/check_spec.py", "specifications/openhands-decision-gates.json"], "scope": "offline OpenHands gate insertion lifecycle", "expected_result": "invariants-hold", "timeout_seconds": 60, "model": {"states": ["action", "gated", "sandboxed", "packet-created", "oracle-decision", "resumed", "observed"], "initial": "action", "transitions": [{"from": "action", "to": "gated"}, {"from": "gated", "to": "sandboxed"}, {"from": "gated", "to": "packet-created"}, {"from": "packet-created", "to": "oracle-decision"}, {"from": "oracle-decision", "to": "resumed"}, {"from": "sandboxed", "to": "observed"}], "forbidden_transitions": [{"from": "action", "to": "observed"}, {"from": "packet-created", "to": "observed"}]}}
