{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-guidance/schema/agent-decision-routing.schema.json",
  "title": "AWG mandatory agent decision routing",
  "description": "The machine-readable wrapper an agent emits before asking for user authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment", "human_interaction", "tui_route"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment": {"$ref": "#/$defs/assessment"},
    "human_interaction": {"$ref": "human-decision-trigger.schema.json"},
    "tui_route": {"$ref": "#/$defs/tui_route"}
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["importance", "reason_codes", "user_authority_required", "continue_independent_work"],
      "properties": {
        "importance": {"enum": ["routine", "important", "critical"]},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"enum": ["user-request", "user-detail-request", "proposal-review", "agent-uncertainty", "policy-required", "design-choice", "conceptual-choice", "high-impact", "irreversible", "project-direction", "security", "privacy", "public-api", "data-model", "migration", "dependency"]}},
        "user_authority_required": {"const": true},
        "continue_independent_work": {"type": "boolean"}
      }
    },
    "tui_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "request_ref", "host_direct_question_forbidden"],
      "properties": {
        "channel": {"const": "workflow-tui"},
        "request_ref": {"type": "string", "pattern": "^AWG-[A-Z0-9-]+$"},
        "host_direct_question_forbidden": {"const": true}
      }
    }
  }
}
