{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-guidance/schema/remote-ssh-enrollment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "task_ref", "task_revision", "enrollment_id", "device_id", "device_public_key", "consent", "host_key_fingerprint", "forwarding", "status", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "remote-ssh-enrollment"},
    "project_id": {"type": "string", "minLength": 1},
    "task_ref": {"type": "string", "pattern": "^AR-[0-9]{4,}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "enrollment_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
    "device_public_key": {"type": "string", "pattern": "^(ssh-|ecdsa-)[A-Za-z0-9+/= ._-]{32,}$"},
    "consent": {"const": true},
    "host_key_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
    "forwarding": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "port", "scope"],
      "properties": {
        "host": {"const": "127.0.0.1"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "scope": {"const": "workflow-service"}
      }
    },
    "status": {"enum": ["pending", "active", "revoked", "expired"]},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
