{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-guidance/schema/human-decision-trigger.schema.json",
  "title": "AWG human decision session trigger",
  "description": "Coordinator-owned AR entry describing when a revision-bound TUI session must be opened.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_ref", "task_revision", "interaction_required", "activation", "decision_status", "reason", "requested_by", "tui_contract_version"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_ref": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 0},
    "interaction_required": {"const": true},
    "activation": {"enum": ["user-decision", "user-detail-request", "user-proposal-review", "agent-uncertainty", "policy-required-approval"]},
    "decision_status": {"enum": ["pending", "presenting", "in_progress", "clarification_requested", "resolved", "superseded", "cancelled"]},
    "reason": {"type": "string", "minLength": 1},
    "requested_by": {"enum": ["user", "agent", "policy"]},
    "decision_request_ref": {"type": "string", "pattern": "^AWG-[A-Z0-9-]+$"},
    "tui_contract_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"}
  }
}
