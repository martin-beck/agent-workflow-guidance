{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-guidance/schema/specification.schema.json",
  "title": "AWG formal specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "version", "decision_class", "objective", "scope", "assumptions", "state_variables", "transitions", "invariants", "acceptance_predicates", "formalization"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "spec_id": {"type": "string", "pattern": "^AWG-SPEC-[A-Z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "decision_class": {"enum": ["design", "conceptual", "operational"]},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "state_variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "transitions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_predicates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "formalization": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "model_ref", "checker", "command", "scope", "expected_result"],
      "properties": {
        "method": {"enum": ["json-schema", "state-machine", "tlaplus", "smtlib", "alloy"]},
        "model_ref": {"type": "string", "minLength": 1},
        "checker": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "scope": {"type": "string", "minLength": 1},
        "expected_result": {"enum": ["pass", "sat", "unsat", "invariants-hold"]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "model": {"type": "object", "additionalProperties": false, "required": ["states", "initial", "transitions", "forbidden_transitions"], "properties": {"states": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "initial": {"type": "string"}, "transitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}}, "forbidden_transitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}}}}
      }
    },
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
