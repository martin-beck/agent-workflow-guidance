{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-guidance/schema/remote-endpoint-candidates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "task_ref", "task_revision", "generated_at", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "remote-endpoint-candidates"},
    "project_id": {"type": "string", "minLength": 1},
    "task_ref": {"type": "string", "pattern": "^AR-[0-9]{4,}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "host", "port", "address_family", "provenance", "priority", "host_key_fingerprints"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,96}$"},
        "host": {"type": "string", "minLength": 1, "maxLength": 253},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "address_family": {"enum": ["name", "ipv4", "ipv6"]},
        "provenance": {"enum": ["ssh_config", "dns", "dns_address", "vpn", "relay", "public_ip"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "host_key_fingerprints": {"type": "array", "items": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"}},
        "expires_at": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
