{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-guidance/schema/decision-record.schema.json",
  "title": "AWG decision record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "record_id", "request_digest", "oracle", "disposition", "selected_candidate", "scope", "specification", "formal_check", "recorded_at"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "request_id": {"type": "string", "pattern": "^AWG-[A-Z0-9-]+$"},
    "record_id": {"type": "string", "pattern": "^AWG-DEC-[A-Z0-9-]+$"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "oracle": {"type": "object", "additionalProperties": false, "required": ["kind", "display_name"], "properties": {"kind": {"const": "human"}, "display_name": {"type": "string", "minLength": 1}}},
    "disposition": {"enum": ["clarified", "selected", "rejected", "deferred", "superseded"]},
    "selected_candidate": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["task_ref", "task_revision", "authority", "conditions"], "properties": {"task_ref": {"type": "string"}, "task_revision": {"type": "integer", "minimum": 0}, "authority": {"enum": ["clarification", "implementation-choice", "bounded-approval", "project-guidance"]}, "conditions": {"type": "array", "items": {"type": "string"}}}},
    "specification": {"$ref": "specification.schema.json"},
    "formal_check": {"$ref": "formal-check-result.schema.json"},
    "oracle_added_candidate": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
    "guidance": {"type": "object", "additionalProperties": false, "required": ["statement", "applicability", "review_after"], "properties": {"statement": {"type": "string", "minLength": 1}, "applicability": {"type": "array", "items": {"type": "string"}}, "counterexamples": {"type": "array", "items": {"type": "string"}}, "review_after": {"type": "string", "format": "date"}}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "supersedes": {"type": "string", "pattern": "^AWG-DEC-[A-Z0-9-]+$"},
    "execution_evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
