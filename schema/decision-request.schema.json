{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-guidance/schema/decision-request.schema.json",
  "title": "AWG decision request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "trigger", "decision_class", "context", "specification", "formal_check", "candidates"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "request_id": {"type": "string", "pattern": "^AWG-[A-Z0-9-]+$"},
    "trigger": {"enum": ["clarification", "decision", "guidance", "mandatory-approval", "recovery"]},
    "decision_class": {"enum": ["design", "conceptual", "operational"]},
    "context": {"$ref": "#/$defs/context"},
    "specification": {"$ref": "specification.schema.json"},
    "formal_check": {"$ref": "formal-check-result.schema.json"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "batch_key": {"type": "string", "minLength": 1},
    "oracle_deadline": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["task_ref", "task_revision", "objective", "constraints"],
      "properties": {
        "task_ref": {"type": "string", "minLength": 1},
        "task_revision": {"type": "integer", "minimum": 0},
        "objective": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "quality_refs": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "action", "rank", "confidence", "rationale", "tradeoffs", "impact", "reversibility"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
        "action": {"type": "string", "minLength": 1},
        "rank": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "tradeoffs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "impact": {"enum": ["low", "medium", "high", "critical"]},
        "reversibility": {"enum": ["easy", "bounded", "difficult", "irreversible"]},
        "downstream_effects": {"type": "array", "items": {"type": "string"}},
        "rollback": {"type": "string", "minLength": 1}
      }
    }
  }
}
